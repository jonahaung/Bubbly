# ---------------------------------------------------------
# SwiftFormat Configuration for Bubbly iOS App
# Author: Aung Ko Min
# Created: 2025-11-09
# ---------------------------------------------------------

# ✅ Swift Version
--swiftversion 5.10

# ✅ Indentation & Spacing
--indent 4
--tabwidth 4
--maxwidth 120
--indentcase true
--xcodeindentation enabled
--linebreaks lf
--commas inline
--ranges spaced
--closingparen same-line
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--wrapconditions before-first
--ifdef no-indent
--elseposition next-line
--guardelse same-line
--semicolons never

# ✅ Whitespace & Newlines
--trimwhitespace always
--insertlines preserve
--nospaceoperators false
--wrapmultilinecomments before-first
--blanklines remove

# ✅ Comments & Docs
--comments ignore
--marktypes always
--markextensions always
--markcategories always
--header ignore
--wrapdoccomments before-first
--stripunusedargs closure-only

# ✅ Imports
--importgrouping testable-first
--organizeimports always
--stripunusedimports always
--sortimportgrouping alphabetized

# ✅ Explicitness & Safety
--self remove
--redundantself remove
--redundantreturn remove
--redundantbackticks remove
--redundantlet remove
--redundantpattern remove
--redundantparens remove

# ✅ SwiftUI & Modern Style
--modifierorder sorted
--wrapmultilineelements before-first
--wrapmultilinestatementbraces before-first
--decimalgrouping 3,3,3
--groupedextension on
--typeattributes prev-line
--protocols sorted
--enumcases sorted

# ✅ Function & Closure Style
--stripunusedargs closure-only
--funcattributes on-line
--funcbrace same-line
--wrapclosurearguments before-first
--wrapreturntype before-first
--voidtype omit
--hoistpattern let
--hoisttry true
--shortoptionals on

# ✅ Formatting Behavior
--disable redundantFileHeader,redundantBackticks
--enable trailingCommas,wrapMultilineStatementBraces,redundantClosure

# ✅ Files to Exclude
--exclude Pods,DerivedData,build,Carthage,fastlane,**/Generated,**/*.g.swift

# ✅ Project Notes
# - Optimized for SwiftUI view consistency
# - Keeps chained modifiers vertically aligned
# - Alphabetically organizes imports and types
# - Cleans closures & guards for readability
# - Compatible with SwiftLint auto-corrections