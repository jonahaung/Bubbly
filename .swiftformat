rules:
  # MARK: - Structure
  - blankLinesBetweenScopes
  - blankLinesAroundMark
  - blankLinesAtStartOfScope
  - blankLinesAtEndOfScope

  # MARK: - Formatting
  - indent
  - linebreaks
  - linebreakAtEndOfFile
  - braces
  - elseOnSameLine

  # MARK: - Spacing
  - consecutiveBlankLines
  - consecutiveSpaces
  - trailingSpace
  - spaceAroundOperators
  - spaceAroundBraces
  - spaceAroundParens
  - spaceAroundGenerics
  - spaceAroundBrackets
  - spaceAroundComments
  - spaceInsideBraces
  - spaceInsideParens
  - spaceInsideGenerics
  - spaceInsideBrackets
  - spaceInsideComments

  # MARK: - Code Simplification
  - redundantSelf
  - redundantReturn
  - redundantInit
  - redundantLet
  - redundantNilInit
  - redundantParens
  - redundantPattern
  - redundantGet
  - redundantBackticks
  - redundantRawValues
  - redundantVoidReturnType

  # MARK: - Safety / Correctness
  - strongOutlets
  - unusedArguments
  - hoistPatternLet

  # MARK: - Style
  - semicolons
  - numberFormatting
  - ranges
  - specifiers
  - void

  # MARK: - Imports
  - duplicateImports
  - sortedImports

  # MARK: - Misc
  - todos
